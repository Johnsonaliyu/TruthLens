# Railway supplies PORT automatically. Keep this value for local API runs.
PORT=8080
NODE_ENV=production

# AI and evidence providers
GROQ_API_KEY=
NVIDIA_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
TAVILY_API_KEY=

# Optional model overrides. The defaults are already configured in the app.
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Optional local/frontend build setting
BASE_PATH=/